// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(PATRON)
}

model Genre {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  books       Book[]
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  isbn          String   @unique
  publishedYear Int?
  genreId       Int
  genre         Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@index([genreId])
}
